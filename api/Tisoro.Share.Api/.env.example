# Copy to .env (same folder) and fill in. .env is git-ignored — never commit real keys.
# Leave a value blank to keep that platform switched off.

# Origin the browser uses; redirect URIs are {this}/api/oauth/<platform>/callback
OAUTH_PUBLIC_BASE_URL=https://127.0.0.1:4200

# LinkedIn Developers → app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta for Developers → App settings → Basic
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Meta app → Instagram → API setup with Instagram login (different from the Facebook App ID)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok for Developers → app → Client key / Client secret
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# X Developer → Keys and tokens → OAuth 2.0 Client ID and Client Secret (not the API key / bearer token)
X_CLIENT_ID=
X_CLIENT_SECRET=
