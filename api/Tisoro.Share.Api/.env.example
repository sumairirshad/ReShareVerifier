# Copy to .env (same folder) and fill in. .env is git-ignored — never commit real keys.
# Leave a value blank to keep that feature switched off.

# Origin the browser uses; OAuth redirect URIs are {this}/api/oauth/<platform>/callback
OAUTH_PUBLIC_BASE_URL=https://127.0.0.1:4200

# LinkedIn Developers → app → Auth  (products: Sign In with LinkedIn using OpenID Connect, Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X Developer → Keys and tokens
#   OAuth 2.0 Client ID/Secret: "Repost through Tisoro" (scopes users.read tweet.read tweet.write)
#   Bearer Token (app-only):    "Repost on X yourself" — finds the partner in the reposts/quotes of Tisoro's post
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Meta for Developers → App settings → Basic  (Facebook Login for Business: pages_show_list, pages_manage_posts, pages_read_engagement)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram Story mentions (Tisoro's own account receives the webhook — partners don't sign in)
#   App secret:     Meta app → Instagram → API setup with Instagram login → Instagram app secret
#   Verify token:   any random string; enter the same one in the Meta webhook settings
#   Access token:   long-lived token for Tisoro's Instagram account (instagram_business_basic, instagram_business_manage_messages)
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_TISORO_ACCESS_TOKEN=

# TikTok for Developers → app  (Login Kit + Content Posting API with Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public HTTPS URL of the ceremony video file, on a domain verified in the TikTok app
TIKTOK_VIDEO_URL=

# Tisoro admin view (/admin/ceremonies/<id>). Any long random string; blank = admin view off.
ADMIN_KEY=
